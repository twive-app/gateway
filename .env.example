# twive-gateway configuration file
#   cp .env.example .env   # Bun loads .env automatically; compose.yml uses it as env_file
# Empty values count as unset (= default). The REQUIRED block has no defaults – the gateway won't start without it.
# Secrets can also be read from a file (Docker secrets): set <NAME>_FILE instead of <NAME>, never both.

# ---- REQUIRED --------------------------------------------------------------------------------------------------------
# Public HTTPS URL of POST /twitch/webhook/callback (Twitch only calls HTTPS on port 443)
TWITCH_WEBHOOK_CALLBACK_URL=
# HMAC secret for EventSub, 10–100 characters (e.g. openssl rand -hex 32)
TWITCH_WEBHOOK_SECRET=
# File containing the HMAC secret for EventSub (e.g. /run/secrets/twitch_webhook_secret)
# TWITCH_WEBHOOK_SECRET_FILE=

# ---- General ---------------------------------------------------------------------------------------------------------
# Name of the environment, shown on startup (default: prod)
ENVIRONMENT=
# Time zone of log timestamps, e.g. Europe/Berlin (default: system time zone, UTC in Docker)
# TZ=

# ---- Redis -----------------------------------------------------------------------------------------------------------
# With compose.yml: leave REDIS_HOST empty to use the bundled Redis (then also leave username and password empty), or
# set it to use your own Redis – compose.yml picks it up automatically.
# Host (default: localhost)
REDIS_HOST=
# Port (default: 6379)
REDIS_PORT=
# ACL user (default: none)
REDIS_USERNAME=
# Password (default: none)
REDIS_PASSWORD=
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# Database number (default: 0)
REDIS_DB=

# ---- HTTP server: webhook callback, GET /health ----------------------------------------------------------------------
# Bind address (default: 0.0.0.0)
SERVER_HOST=
# Port (default: 3000)
SERVER_PORT=
# Reverse proxies whose X-Forwarded-For is trusted (HTTP server and gateway): IPs and CIDRs, comma separated, e.g.
# 127.0.0.1,::1 or 172.16.0.0/12 for a proxy reaching the container through the Docker bridge. Without it the socket
# address is the client's address (default: none – see "Client addresses" in docs/SETUP.md)
TRUSTED_PROXIES=

# ---- WebSocket gateway -----------------------------------------------------------------------------------------------
# Bind address (default: SERVER_HOST)
GATEWAY_HOST=
# Port (default: 3001)
GATEWAY_PORT=
# Heartbeat interval in ms, min 5000 (default: 41250)
GATEWAY_HEARTBEAT_INTERVAL=
# Time to IDENTIFY/RESUME after connecting in ms, min 1000 (default: 30000)
GATEWAY_IDENTIFY_TIMEOUT=
# How long a disconnected session stays resumable in ms, 0 = not resumable (default: 120000)
GATEWAY_RESUME_TIMEOUT=
# Events kept per session for RESUME (default: 500)
GATEWAY_REPLAY_BUFFER_SIZE=
# Max size of a client message in bytes, min 512 (default: 4096)
GATEWAY_MAX_PAYLOAD_SIZE=
# Rate limit: max client messages per window (default: 120)
GATEWAY_RATE_LIMIT_MAX_MESSAGES=
# Rate limit window in ms, min 1000 (default: 60000)
GATEWAY_RATE_LIMIT_WINDOW_MS=
# Max connections in total, 0 = unlimited (default: 0)
GATEWAY_MAX_CONNECTIONS=
# Max simultaneous connections per client address, 0 = unlimited (default: 100)
GATEWAY_MAX_CONNECTIONS_PER_IP=
# IPv6 prefix length the per-address limits count by, 32–128, 128 = every address on its own (default: 64)
GATEWAY_IPV6_PREFIX_LENGTH=
# Failed IDENTIFY/RESUME (wrong secret, unknown botUserId) per client address and window before its connections are
# rejected until the window ends, 0 = off (default: 10)
GATEWAY_AUTH_FAILURE_LIMIT=
# Window of GATEWAY_AUTH_FAILURE_LIMIT in ms, min 1000 (default: 600000)
GATEWAY_AUTH_FAILURE_WINDOW_MS=

# ---- Health push (optional, for push monitors – see "Monitoring" in the README) -------------------------------------
# URL the gateway calls regularly while it is healthy, http:// or https://. Empty = off (default). If it has the query
# parameters status/msg/ping they are filled in (status=up|down, msg=OK|reason, ping=Redis latency in ms).
HEALTH_PUSH_URL=
# HEALTH_PUSH_URL_FILE=/run/secrets/health_push_url
# Interval in seconds, min 10 (default: 60)
HEALTH_PUSH_INTERVAL=

# ---- Logging ---------------------------------------------------------------------------------------------------------
# Debug logs: true/false, 1/0, yes/no, on/off (default: false)
LOG_DEBUG=
